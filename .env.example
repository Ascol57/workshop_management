# Identifiants de connexion a la base de donnees du module M3.
#
# Copiez ce fichier en .env a la racine du projet et renseignez vos valeurs :
#     cp .env.example .env
#
# Le fichier .env est ignore par git (voir .gitignore) : votre mot de passe ne
# partira donc jamais dans le depot. Ce fichier-ci, .env.example, est versionne
# et ne doit contenir aucun secret.
#
# En production (Docker, Tomcat), il n'y a pas de fichier .env : definissez
# plutot ces memes noms comme variables d'environnement. Elles ont de toute
# facon priorite sur le contenu de .env.

# Serveur MySQL du module M3.
# Ces deux lignes peuvent etre laissees telles quelles.
DB_HOST=92.222.25.165
DB_PORT=3306

# Nom de votre base de donnees, de la forme m3_votreidentifiant. Obligatoire.
DB_NAME=

# Nom d'utilisateur MySQL. Sur le serveur du module il est identique au nom de
# la base : laissez cette ligne commentee sauf si les deux different chez vous.
#DB_USER=

# Votre mot de passe MySQL. Obligatoire.
# Si le mot de passe contient un caractere #, entourez-le de guillemets :
#     DB_PASSWORD="mon#mot#de#passe"
DB_PASSWORD=
